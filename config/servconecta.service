[Unit]
Description=Gunicorn daemon para o app ServConecta
After=network.target postgresql.service

[Service]
User=root
Group=www-data
WorkingDirectory=/www/wwwroot/serv-conecta
EnvironmentFile=/www/wwwroot/serv-conecta/.env
ExecStart=/www/wwwroot/serv-conecta/.venv/bin/gunicorn config.wsgi:application \
          --workers 4 \
          --bind 127.0.0.1:8000 \
          --access-logfile /www/wwwroot/serv-conecta/gunicorn-access.log \
          --error-logfile /www/wwwroot/serv-conecta/gunicorn-error.log

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
