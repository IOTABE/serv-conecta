# ==============================================================================
# ServConecta - Configuração de Variáveis de Ambiente (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# AMBIENTE (desenvolvimento ou producao)
# ------------------------------------------------------------------------------
# desenvolvimento: ativa DEBUG, utiliza SQLite local e desativa HTTPS forçado.
# producao: desativa DEBUG, utiliza PostgreSQL, forca HTTPS/HSTS e WhiteNoise.
DJANGO_ENV=desenvolvimento

# ------------------------------------------------------------------------------
# SEGURANÇA (SECRET KEY)
# ------------------------------------------------------------------------------
# Em desenvolvimento possui fallback inseguro, mas é recomendado preencher.
# Em produção é OBRIGATÓRIO definir uma chave única e segura.
DJANGO_SECRET_KEY=django-insecure-sua-chave-local-aqui

# ------------------------------------------------------------------------------
# REDE E CSRF
# ------------------------------------------------------------------------------
# Domínios permitidos (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.10.187,192.168.0.112

# Origens confiáveis para CSRF (separadas por vírgula)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# BANCO DE DADOS (Exigido apenas se DJANGO_ENV=producao)
# ------------------------------------------------------------------------------
POSTGRES_DB=servconecta
POSTGRES_USER=servconecta_user
POSTGRES_PASSWORD=sua_senha_postgres_aqui
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
